# Copie este arquivo para ".env" e ajuste se precisar. Nunca suba o ".env" para o GitHub.
PORT=3000
HOST=0.0.0.0
# Pasta onde ficam o banco e o segredo do login (relativa à pasta backend)
DATA_DIR=data
# Segredo para assinar os logins. Se ficar em branco, um segredo é gerado e guardado em data/jwt.secret
JWT_SECRET=
# Duração do login, em horas
TOKEN_HORAS=12
